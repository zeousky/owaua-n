OPENAI_FULL_MODEL=gpt-6-luna



DISCORD_TOKEN=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
INCEPTION_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek V4.1 Flash is hosted by InferX on its endpoint API surface.
DEEPSEEK_BASE_URL=https://model.inferx.net/endpoints/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7


OWAUA_LOCAL_ONLY=0
OWAUA_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
OWAUA_LOCAL_MODEL=default_model



OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gpt-oss:20b
OWAUA_LOCAL_AI_ROOT=
OWAUA_LOCAL_AI_MODEL_PATH=
# Ignored. Search, images, and full mode use gpt-6-luna. Chat can select Grok.
CHAT_MODEL=gpt-6-luna


OWAUA_GEMINI_ONLY=0
CLAUDE_FULL_MODEL=anthropic/claude-haiku-4-5
GEMINI_FULL_MODEL=google/gemini-3.5-flash-lite
GLM_FULL_MODEL=zai/glm-5.3-flash


# Comma-separated Discord IDs. Set these for your own bot; blank means no owner-only commands.
BOT_OWNER_IDS=
BOT_BLOCKED_USER_IDS=
# Empty allows all invited guilds; list IDs to restrict access.
BOT_ALLOWED_GUILD_IDS=
# Optional allowlists. Full mode is unavailable until its access/location IDs are configured.
BOT_FULL_MODE_GUILD_IDS=
BOT_FULL_MODE_CHANNEL_IDS=
BOT_FULL_MODE_ENABLE_USER_IDS=
BOT_FULL_MODE_ALLOWED_USER_IDS=
BOT_FULL_MODE_BLOCKED_USER_IDS=
# Empty keeps the standard bounded music behavior in every server.
BOT_UNRESTRICTED_MUSIC_GUILD_IDS=
BOT_ALLOW_DMS=0
BOT_MAX_INFLIGHT=3
# JSONL audit log for every !music attempt. Relative paths are resolved from the repo.
MUSIC_AUDIT_LOG=data/music-audit.jsonl


CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_LOG_URL=
CLOUDFLARE_LOG_TOKEN=


# Shared across chat, repairs, memory extraction and summaries. 0 disables quota.
API_REQUESTS_PER_USER=30
API_WINDOW_SECONDS=600
